# Скопируйте в .env и поправьте под себя: cp .env.example .env

# --- Сервис ---
MLWRAP_ENVIRONMENT=local
MLWRAP_HOST=0.0.0.0
MLWRAP_PORT=8000
MLWRAP_LOG_LEVEL=INFO
MLWRAP_LOG_FORMAT=console

# --- Аутентификация: none | basic | jwt ---
MLWRAP_AUTH_MODE=none
# JSON: пароль в открытом виде или bcrypt-хеш (mlwrap hash-password)
MLWRAP_AUTH_USERS={"admin":"admin"}
MLWRAP_JWT_SECRET=change-me
MLWRAP_JWT_TTL_MINUTES=60

# --- Модели ---
# Модули с зарегистрированными моделями (через запятую или JSON-массив)
MLWRAP_PLUGIN_MODULES=
MLWRAP_PRELOAD_MODELS=echo
MLWRAP_AUTO_LOAD=true
# Настройки конкретных моделей: {"iris": {"n_estimators": 200}}
MLWRAP_MODELS_CONFIG=
MLWRAP_PREDICT_TIMEOUT_SECONDS=60

# --- БД (необязательна) ---
MLWRAP_DATABASE_URL=postgresql+asyncpg://mlwrap:mlwrap@localhost:5432/mlwrap
MLWRAP_PERSIST_INFERENCES=true
MLWRAP_PERSIST_PAYLOADS=false

# --- Метрики ---
MLWRAP_METRICS_ENABLED=true
MLWRAP_METRICS_PROTECTED=false
